#!/bin/sh
# nerves_sign post-processing hook. Nerves runs this with the built rootfs
# image path as the first argument. It bridges into Elixir and runs the
# secure-boot pipeline (hash tree -> initramfs -> boot.img -> sign).
#
# Wired via:
#   config :nerves, :firmware,
#     post_processing_script: Path.expand("priv/nerves_sign/post_process")
set -e

FS_PATH="$1"
echo "nerves_sign: post-processing ${FS_PATH}"

# Run the Elixir side in the CALLER'S target env, not host. `config
# :nerves_sign` lives in the project's target config, which only loads when
# MIX_TARGET is the target — flipping to host silently drops it and the run
# dies with "set `config :nerves_sign, board: ...`". The target build is
# already compiled (mix firmware just used it), so this starts instantly and
# runs plain BEAM code on the build host.
mix run --no-start -e "NervesSign.run(\"${FS_PATH}\")"

echo "nerves_sign: post-processing done"
